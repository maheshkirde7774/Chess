{
  "name": "neon-four-chess",
  "version": "1.0.0",
  "description": "FOURX - Four-player chess game with FastAPI backend and Capacitor Android app",
  "main": "frontend/index.html",
  "scripts": {
    "start": "python backend/run.py",
    "test": "pytest backend/tests",
    "backup": "python scripts/create_backup.py",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:build:android": "cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "chess",
    "four-player-chess",
    "cyberpunk",
    "fastapi",
    "websockets",
    "capacitor",
    "android"
  ],
  "author": "Antigravity Senior Full-Stack Game Dev",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
