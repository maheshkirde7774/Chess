# Neon Four Chess - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database Configuration (SQLite default, PostgreSQL optional for production)
DATABASE_URL=sqlite:///./neon_four_chess.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neon_four_chess

# Allowed CORS Origins (set to specific origins or * for mobile apps)
CORS_ORIGINS=*

# Frontend / Android Client Backend URL
# - Local Browser: http://localhost:8000
# - Real Android Phone / Emulator: http://192.168.1.X:8000 (Replace with your machine's LAN IP)
# - Production Server: https://your-server-domain.com
NEON_CHESS_BACKEND_URL=http://localhost:8000
