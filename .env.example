# Neon Four Chess - Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True

# Database Configuration (SQLite default, PostgreSQL optional for production)
DATABASE_URL=sqlite:///./neon_four_chess.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/neon_four_chess

# Allowed CORS Origins (comma-separated list of origins; default includes localhost and capacitor://localhost)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,capacitor://localhost,https://localhost

# Frontend / Android Client Backend URL
# - Local Browser: http://localhost:8000
# - Real Android Phone / Emulator: http://192.168.1.X:8000 (Replace with your machine's LAN IP)
# - Production Server: https://your-server-domain.com
NEON_CHESS_BACKEND_URL=http://localhost:8000

# Google Play Developer API (server-side only; never put service-account keys in the app)
GOOGLE_PLAY_PACKAGE_NAME=com.neonchess.fourplayer
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FOURX_PLAY_TOKEN_ENCRYPTION_KEY=

# Optional Google Play Real-time Developer Notifications (Pub/Sub push)
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
